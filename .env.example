# Copiez ce fichier en .env puis remplissez-le. Ne partagez jamais votre .env.

# "demo" = données fictives, aucune clé nécessaire. "reel" = sources réelles configurées.
BOT_MODE=demo

# --- Discord ----------------------------------------------------------------
# Jeton du bot : Discord Developer Portal > votre application > Bot > Reset Token.
DISCORD_BOT_TOKEN=
# Facultatif mais conseillé : identifiant de votre serveur, pour que les commandes slash
# apparaissent immédiatement (clic droit sur le serveur > Copier l'identifiant du serveur).
DISCORD_GUILD_ID=
# Facultatif : salons de VOTRE serveur où arrivent des annonces de restock « suivies » depuis d'autres
# serveurs (bouton « Suivre » d'un salon d'annonces). Identifiants séparés par des virgules.
# Exige d'activer « Message Content Intent » dans le Developer Portal (Bot > Privileged Gateway Intents).
DISCORD_SALONS_VEILLE=
# Version « site + webhook » (py -m pokebot tache, GitHub Actions) : URL du webhook du salon où poster.
# Discord : Paramètres du serveur > Intégrations > Webhooks > Nouveau webhook > Copier l'URL. C'est un secret.
DISCORD_WEBHOOK_URL=
# Facultatif : identifiants d'utilisateurs Discord autorisés, séparés par des virgules.
# Vide = tout membre qui voit le bot peut l'utiliser.
DISCORD_UTILISATEURS_AUTORISES=

# --- Livraison --------------------------------------------------------------
# Code postal transmis aux sources capables d'estimer la livraison (aucune actuellement).
CODE_POSTAL=75001

# --- Amazon Creators API (Associates Central > Creators API) -------------------
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# 3.1 = Amérique du Nord, 3.2 = Europe (France), 3.3 = Extrême-Orient
AMAZON_CREDENTIAL_VERSION=3.2
# Votre identifiant de suivi Partenaires Amazon.fr (se termine souvent par -21)
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.fr

# --- Fichiers (facultatif) ----------------------------------------------------
# CHEMIN_BASE=data/pokeveille.sqlite3
# CHEMIN_CATALOGUE=data/catalogue.csv
# CHEMIN_OFFRES_MANUELLES=data/offres_manuelles.csv
